{ config, lib, pkgs, utils, inputs, ... }:

let
  cfg = config.lab.impermanence;
  layout = cfg.layout;
  persist = "/persist";
  marker = "${persist}/.lab-impermanence-armed";
  oldRootsKept = 5;

  svc = name: config.services.${name}.enable or false;
  hasDockerDisk = config.fileSystems ? "/var/lib/docker";

  # btrfs mounts subvolumes natively; bcachefs has no subvol= option, util-linux X-mount.subdir does the bind
  subvolMount = subvol: extra: {
    device = layout.device;
    fsType = layout.fsType;
    options = (if layout.fsType == "btrfs" then [ "subvol=${subvol}" ] else [ "X-mount.subdir=${subvol}" ])
      ++ layout.mountOptions;
  } // extra;

  sshHostKeyFiles = lib.concatMap (k: [ k.path "${k.path}.pub" ]) config.services.openssh.hostKeys;

  directories = [
    "/var/log"
    "/var/lib/nixos"
    "/var/lib/systemd"
    { directory = "/var/lib/private"; mode = "0700"; }
    { directory = "/root/.ssh"; mode = "0700"; }
    "/var/db/sudo"
  ]
  ++ lib.optional config.networking.networkmanager.enable { directory = "/etc/NetworkManager/system-connections"; mode = "0700"; }
  ++ lib.optional (svc "tailscale") "/var/lib/tailscale"
  ++ lib.optional config.hardware.bluetooth.enable "/var/lib/bluetooth"
  ++ lib.optional (svc "fprintd") "/var/lib/fprint"
  ++ lib.optional (svc "fwupd") "/var/lib/fwupd"
  ++ lib.optional (svc "tlp") "/var/lib/tlp"
  ++ lib.optional (svc "upower") "/var/lib/upower"
  ++ lib.optional (svc "flatpak") "/var/lib/flatpak"
  ++ lib.optional (svc "printing") "/var/lib/cups"
  ++ lib.optional (svc "linux-enable-ir-emitter") "/var/lib/linux-enable-ir-emitter"
  ++ lib.optional (config.services.hardware.openrgb.enable or false) "/var/lib/OpenRGB"
  ++ lib.optional (svc "lact" && config.services.lact.settings == { }) "/etc/lact"
  ++ lib.optional (config.virtualisation.docker.enable && !hasDockerDisk) "/var/lib/docker"
  ++ lib.optional config.virtualisation.podman.enable "/var/lib/containers"
  ++ lib.optional config.virtualisation.libvirtd.enable "/var/lib/libvirt"
  ++ lib.optional (config.systemd.services ? flamenco-worker) "/var/lib/flamenco-worker"
  ++ lib.optional (lib.hasPrefix "/var/lib/sops-nix/" (toString (config.sops.age.keyFile or ""))) "/var/lib/sops-nix"
  ++ lib.optional (config.boot ? lanzaboote && config.boot.lanzaboote.enable) config.boot.lanzaboote.pkiBundle;

  files = [ "/etc/machine-id" ] ++ sshHostKeyFiles;

  pathOf = d: if builtins.isAttrs d then d.directory else d;
  keptPaths = map pathOf directories ++ files;

  # trees that are not on @root after migration, regenerated by NixOS, or meant to be thrown away
  ephemeralPaths = [
    "/nix" "/home" persist "/boot" "/proc" "/sys" "/dev" "/run" "/tmp" "/var/tmp" "/var/cache"
    "/etc/static" "/etc/.clean" "/etc/.updated" "/etc/NIXOS" "/etc/.pwd.lock" "/etc/mtab"
    "/etc/passwd" "/etc/group" "/etc/shadow" "/etc/gshadow" "/etc/subuid" "/etc/subgid"
    "/etc/sudoers" "/etc/resolv.conf" "/etc/resolv.conf.bak" "/etc/ssh/authorized_keys.d"
    "/var/.updated" "/var/lib/systemd/coredump" "/var/lib/docker" "/var/lib/lastlog"
    "/bin" "/usr" "/lib" "/lib64" "/srv" "/mnt" "/media" "/root/.cache" "/root/.nix-defexpr"
    "/root/.nix-profile" "/root/.nix-channels" "/root/.local/state/nix" "/lost+found" "/.snapshots"
    "/var/run" "/var/lock"
  ];

  # run before the first armed boot: prints what would vanish and checks the boot prerequisites
  diffScript = pkgs.writeShellApplication {
    name = "lab-impermanence-diff";
    runtimeInputs = [ pkgs.coreutils pkgs.findutils pkgs.gnugrep pkgs.gnused pkgs.gawk ];
    text = ''
      if [ "$(id -u)" -ne 0 ]; then echo "run as root" >&2; exit 1; fi

      echo "== preflight"
      check() { if [ -e "$1" ]; then echo "ok      $1"; else echo "MISSING $1  ($2)"; fi; }
      ${lib.concatMapStrings (f: ''check ${lib.escapeShellArg "${persist}${f}"} "persisted file"
      '') sshHostKeyFiles}
      check ${persist}/etc/machine-id "persisted file"
      ${lib.concatMapStrings (u: ''check ${lib.escapeShellArg "${persist}/passwords/${u}"} "hashedPasswordFile, login fails without it"
      '') passwordUsers}
      if [ -e ${marker} ]; then echo "ARMED   ${marker} exists, the next boot wipes /"; else echo "safe    ${marker} absent, boots do not wipe /"; fi

      echo
      echo "== on / but neither persisted nor ephemeral (lost on the next armed boot)"
      prune=()
      for p in ${lib.escapeShellArgs (keptPaths ++ ephemeralPaths)}; do prune+=(-path "$p" -o); done
      clean=$(mktemp)
      out=$(mktemp)
      trap 'rm -f "$clean" "$out"' EXIT
      # /etc/.clean lists files NixOS copies into /etc on every activation
      if [ -f /etc/.clean ]; then sed 's|^|/etc/|' /etc/.clean > "$clean"; fi
      find / -xdev \( "''${prune[@]}" -false \) -prune -o \
        \( -lname '/nix/store/*' -o -lname '/etc/static/*' \) -prune -o \
        \( -type f -o -type l \) -print \
        | grep -vxFf "$clean" > "$out" || true
      cat "$out"
      echo
      echo "== summary: $(wc -l < "$out") files, by directory"
      awk -F/ '{ c["/" $2 "/" $3 "/" $4]++ } END { for (k in c) printf "%7d %s\n", c[k], k }' "$out" | sort -rn
    '';
  };

  # fixed list: deriving it from users.users and then defining users.users recurses
  passwordUsers = [ "justkowal" ];

  rollbackScript =
    let
      snapshotCmd = if layout.fsType == "btrfs"
        then "btrfs subvolume snapshot \"$top/@root-blank\" \"$top/@root\""
        else "bcachefs subvolume snapshot \"$top/@root-blank\" \"$top/@root\"";
      deleteCmd = if layout.fsType == "btrfs"
        then "btrfs subvolume delete --recursive"
        else "bcachefs subvolume delete";
    in ''
      top=/run/lab-rollback
      mkdir -p "$top"
      mount -t ${layout.fsType} ${lib.optionalString (layout.fsType == "btrfs") "-o subvolid=5"} ${lib.escapeShellArg layout.device} "$top"
      trap 'umount "$top"' EXIT

      for need in @root @root-blank @persist; do
        if [ ! -e "$top/$need" ]; then
          echo "lab-impermanence: $need missing, NOT wiping /"
          exit 0
        fi
      done
      marker=${lib.escapeShellArg "@persist/${lib.removePrefix "${persist}/" marker}"}
      if [ ! -e "$top/$marker" ]; then
        echo "lab-impermanence: not armed ($marker absent), NOT wiping /"
        exit 0
      fi

      # keep the previous roots around so a missed persist path is recoverable
      mkdir -p "$top/@old_roots"
      old="$top/@old_roots/$(date -u +%Y%m%dT%H%M%S)"
      mv "$top/@root" "$old"
      if ! ${snapshotCmd}; then
        echo "lab-impermanence: snapshot failed, restoring previous root"
        mv "$old" "$top/@root"
        exit 1
      fi

      ls -1 "$top/@old_roots" | sort | head -n -${toString oldRootsKept} | while read -r r; do
        ${deleteCmd} "$top/@old_roots/$r" || echo "lab-impermanence: could not delete old root $r"
      done
    '';

  deviceUnit = "${utils.escapeSystemdPath layout.device}.device";
in
{
  imports = [ inputs.impermanence.nixosModules.impermanence ];

  options.lab.impermanence = {
    enable = lib.mkEnableOption "wiping / on every boot (requires the layout in docs/IMPERMANENCE_MIGRATION.md)";

    iUnderstandRootIsWiped = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Second switch: set to true to acknowledge that everything on / not listed for persistence is deleted at boot.";
    };

    layout = lib.mkOption {
      default = null;
      description = "The migrated subvolume layout (@root, @root-blank, @nix, @persist, @home). null means not migrated.";
      example = lib.literalExpression ''{ fsType = "btrfs"; device = "/dev/mapper/cryptroot"; mountOptions = [ "compress=zstd" "noatime" ]; }'';
      type = lib.types.nullOr (lib.types.submodule {
        options = {
          fsType = lib.mkOption { type = lib.types.enum [ "btrfs" "bcachefs" ]; };
          device = lib.mkOption {
            type = lib.types.str;
            description = "Block device holding the subvolumes, as a /dev path.";
          };
          mountOptions = lib.mkOption {
            type = lib.types.listOf lib.types.str;
            default = [ "noatime" ];
          };
        };
      });
    };
  };

  config = lib.mkMerge [
    # buildable before enabling: nix build .#nixosConfigurations.<host>.config.system.build.labImpermanenceDiff
    { system.build.labImpermanenceDiff = diffScript; }

    (lib.mkIf cfg.enable {
      assertions = [
        {
          assertion = cfg.iUnderstandRootIsWiped;
          message = "lab.impermanence.enable wipes / on every boot. Also set lab.impermanence.iUnderstandRootIsWiped = true after reading docs/IMPERMANENCE_MIGRATION.md.";
        }
        {
          assertion = layout != null;
          message = "lab.impermanence.layout must describe the migrated subvolume layout (docs/IMPERMANENCE_MIGRATION.md).";
        }
        {
          assertion = config.boot.initrd.systemd.enable;
          message = "lab.impermanence: the root rollback runs as a systemd initrd service, boot.initrd.systemd.enable must be true.";
        }
        {
          assertion = layout == null || lib.hasPrefix "/dev/" layout.device;
          message = "lab.impermanence.layout.device must be a /dev path.";
        }
      ];
    })

    (lib.mkIf (cfg.enable && cfg.iUnderstandRootIsWiped && layout != null) {
      fileSystems."/" = lib.mkForce (subvolMount "@root" { });
      fileSystems."/nix" = lib.mkForce (subvolMount "@nix" { neededForBoot = true; });
      fileSystems.${persist} = lib.mkForce (subvolMount "@persist" { neededForBoot = true; });
      # sops reads the age key from ~/.config during activation, before normal mounts
      fileSystems."/home" = lib.mkForce (subvolMount "@home" { neededForBoot = true; });

      environment.persistence.${persist} = {
        hideMounts = true;
        inherit directories files;
      };

      # passwords set with passwd live in /etc/shadow, which is regenerated on every boot
      users.mutableUsers = false;
      users.users = lib.genAttrs passwordUsers (u: {
        hashedPasswordFile = lib.mkDefault "${persist}/passwords/${u}";
      });

      # sops must see the persisted ssh host key, impermanence binds it in its own activation step
      system.activationScripts.setupSecrets = {
        deps = [ "persist-files" ];
        text = lib.mkDefault "";
      };

      environment.systemPackages = [ diffScript ];

      boot.initrd.systemd.initrdBin = lib.optional (layout.fsType == "btrfs") pkgs.btrfs-progs;
      boot.initrd.systemd.services.lab-root-rollback = {
        description = "Restore / from the blank snapshot";
        wantedBy = [ "initrd.target" ];
        requires = [ deviceUnit ];
        after = [ deviceUnit ] ++ lib.optional (layout.fsType == "bcachefs")
          "unlock-bcachefs-${utils.escapeSystemdPath "/"}.service";
        before = [ "sysroot.mount" ];
        unitConfig.DefaultDependencies = "no";
        serviceConfig.Type = "oneshot";
        script = rollbackScript;
      };
    })
  ];
}
